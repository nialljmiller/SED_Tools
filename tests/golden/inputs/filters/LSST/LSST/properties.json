 "definitions": {
  "AfAv": "A(lambda)/A(V) at lambda = WavelengthPivot from the extinction law (see extinction); dimensionless",
  "Fsun": "band-averaged f_lambda of the Sun at 1 AU, integral(W S) / integral(W) with S the sun_spectrum and W the curve's detector-aware weight (T energy-counting, T*lambda photon-counting), trapezoidal rule on the curve's samples: the weight of ZeroPointVega_flam",
  "colors": "DisplayColor is an sRGB hex for plotting (sed_tools.filter_colors). ColorMethod 'true': CIE D65 daylight seen through the curve, for bands with VisibleFraction (share of the throughput between 380 and 750 nm) of at least 0.5; 'false': ordered false colour for ultraviolet and infrared bands.",
  "extinction": {
   "R_V": 3.1,
   "dust_extinction_version": "1.7",
   "implementation": "dust_extinction.parameter_averages.F99 (dust_extinction >= 1.6)",
   "law": "Fitzpatrick (1999) Milky Way R(V)-dependent extinction curve",
   "normalisation": "A(V) is the law's own normalisation, the extinction averaged over the V band: A(lambda)/A(V) = 1 at 5414 Angstrom and 0.978 at 5500 Angstrom (https://dust-extinction.readthedocs.io/en/latest/dust_extinction/normalization_details.html)",
   "out_of_range": "null where the pivot lies outside the implementation's F99.x_range; never extrapolated",
   "quantity": "AfAv = A(lambda)/A(V) at the pivot wavelength",
   "references": [
    "Fitzpatrick 1999, PASP 111, 63 (1999PASP..111...63F, doi:10.1086/316293): the law",
    "Gordon 2024, JOSS 9(100), 7023 (doi:10.21105/joss.07023): dust_extinction"
   ],
   "valid_range_angstrom": [
    1000.0,
    33333.333333333336
   ],
   "valid_range_per_micron": [
    0.3,
    10.0
   ]
  },
  "module": "sed_tools.filter_properties (SED_Tools 0.4.1)",
