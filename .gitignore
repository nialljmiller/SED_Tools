# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.env/
.venv/
env/
venv/

# Build artifacts
*.egg-info/
dist/
build/
*.egg
*.manifest
*.spec

# Notebook checkpoints
.ipynb_checkpoints/

# Operating system clutter
.DS_Store
Thumbs.db

# Logs and caches
*.log
.cache/
.mypy_cache/

# IDE settings
.vscode/
.idea/

# Generated data products
/data/
SED_tools/data/
*/data/**i
data/*.txt

/plots/
SED_tools/plots/
*/plots/**

*.bin
*.h5
*.fits
*.txz
*.dat
*.csv
*.json
*.pt
*.json
# Trained models / artifacts
models/*.keras
models/*.params
models/*training*.png
models/*prediction*.png

# Archives / data dumps
*.tar
*.tar.gz
*.tgz

# Random output images
*.png

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
# server branch exceptions
!data/count.txt
!data/counter.php
!data/index.html
!data/index.json
!filter_info/references.json
!filter_info/curated/*.json
!filter_info/curated/instruments/*.json
!filter_info/svo_instruments.json

# Test fixtures are excerpts of published curves; *.dat above would otherwise drop them
!tests/fixtures/**/*.dat

# Official CIE colour tables shipped with sed_tools.filter_colors
!sed_tools/cie/*.csv
!grid_info/curated/*.json

# Fixed inputs and recorded outputs of the golden tests (tests/golden/cases.py)
!tests/golden/**
tests/golden/**/__pycache__/

# Server working trees (never commit)
/backups/
/staging/
/grid_holding/
/source_evidence/
